{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TdPrint",
  "mainBinaryName": "print-bridge",
  "version": "0.2.10",
  "identifier": "com.td.printbridge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TdPrint",
        "width": 960,
        "height": 680,
        "maxWidth": 960,
        "maxHeight": 680,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "linux": {
      "rpm": {
        "provides": [
          "print-bridge"
        ],
        "conflicts": [
          "print-bridge-server"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzRTFENEE5M0E1MzhDM0UKUldRK2pGTTZxZFRoSXpvalJvU25VT042R0orQU5mampnMDZNUjB2Ukg2bnZ0QnhhcSt4V2ZZdlYK",
      "endpoints": [
        "https://github.com/bcdws/print-bridge/releases/latest/download/latest.json"
      ]
    }
  }
}
